# AWS Configuration (populated by saml2aws login automatically)
# These are optional — the SDK reads from ~/.aws/credentials by default
AWS_REGION=eu-west-1
AWS_PROFILE=default

# Bedrock Model (override if needed)
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Alert Sinks (future use)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# SNS_TOPIC_ARN=arn:aws:sns:eu-west-1:123456789012:sentinel-alerts
