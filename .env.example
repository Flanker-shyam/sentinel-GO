# AWS Configuration (populated by saml2aws login automatically)
# These are optional — the SDK reads from ~/.aws/credentials by default
AWS_REGION=
AWS_PROFILE=default

# Bedrock Model (override if needed)
BEDROCK_MODEL_ID=

# Google Chat Notification
# Get webhook URL from: Google Chat Space → Apps & Integrations → Webhooks
GCHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/SPACE_ID/messages?key=KEY&token=TOKEN